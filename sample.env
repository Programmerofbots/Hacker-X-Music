API_ID=
API_HASH=
BOT_TOKEN=
LOGGER_ID=
MONGO_DB_URI=
OWNER_ID=
STRING_SESSION=

# --- Optional but strongly recommended on a VPS ---
# Folder to look for cookie files in. Any file named cookies*.txt inside it
# (cookies.txt, cookies1.txt, cookies2.txt, cookies_alt.txt, etc.) is
# automatically added to a rotation pool - the bot picks one at random per
# request and retries with another if one fails/expires. Using 2-3 separate
# throwaway-account cookie files means one getting rate-limited or expiring
# doesn't take streaming down. Default "." = same folder as config.py.
# See the deployment guide for how to export each cookies*.txt file.
COOKIES_DIR=.

# Optional: a YouTube Data API v3 key from https://console.cloud.google.com
# (enable "YouTube Data API v3" on a project, create an API key). When set,
# search/details lookups use the official API instead of scraping, which is
# far more reliable. Free quota is 10,000 units/day (~100 searches/day),
# so it's used as a fast-path with automatic fallback to scraping if unset
# or if the quota runs out.
YOUTUBE_API_KEY=

# ── Music Download APIs (Auto-Fallback: ArcMusic → Shruti → yt-dlp) ──
# ArcMusic API — register at https://portal.arcmusic.fun/ to get your key
ARC_API_KEY=

# Shruti API — default key works, or get your own from @SHRUTIAPIBOT on Telegram
# SHRUTI_API_KEY=ShrutiBotsFILhdYW5B1AVMsQsPi0W

# Timeout in seconds for API stream downloads (default 900 = 15 min)
# MUSIC_API_TIMEOUT=900

